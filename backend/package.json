{
  "name": "poc-backend",
  "version": "1.0.0",
  "description": "3-Tier Demo Application - Node.js Express Backend with Oracle DB & Redis Cache",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "backup": "node src/scripts/backupRunner.js",
    "backup:cron": "node src/scripts/backupCron.js"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.26.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "oracledb": "^6.7.1",
    "redis": "^4.7.0"
  }
}
