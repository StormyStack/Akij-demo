# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME=Akij-ERP-Cloud

# Oracle Database Configuration
ORACLE_USER=poc_user
ORACLE_PASSWORD=poc_password
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
CACHE_TTL_SECONDS=60

# Seq Structured Logging Server Configuration
SEQ_URL=http://localhost:5341
SEQ_API_KEY=

# Azure Storage Account (Blob Storage) DB Backup & Retention
# Found in: Azure Portal > Storage Account > Access Keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=oracle-backups
BACKUP_CRON_SCHEDULE=0 */12 * * *
BACKUP_RETENTION_DAYS=7
